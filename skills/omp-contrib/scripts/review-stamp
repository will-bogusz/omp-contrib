#!/usr/bin/env python3
"""Record the verdict of an independent review (workflow step 3) against the commit it reviewed.

usage: review-stamp VERDICT [--by NAME] [--sha REF]
       review-stamp --show
  VERDICT   ready | needs-changes: the reviewer's verdict, after you have read its findings
  --by      who reviewed (the agent id, e.g. Review14751c), for the record
  --sha     the reviewed commit, default HEAD; pass it when commits landed after the review began
  --show    print the record for this branch

Run it in the PR's worktree. There is one review round per PR, before it opens:
the fixes for a "needs changes" verdict are not reviewed again; roboomp reviews the PR next.
`precheck` notes a PR with no review recorded, and one whose review asked for changes. The
record sits in the repo's shared git dir (`omp-reviews/<branch>`), so it is never pushed.
"""
import argparse
import datetime
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from omp_pr import VERDICTS, review_log, run  # noqa: E402


def main(argv):
    parser = argparse.ArgumentParser(usage=__doc__.split("\n\n", 2)[1].removeprefix("usage: "))
    parser.add_argument("verdict", nargs="?", choices=VERDICTS)
    parser.add_argument("--by", default="")
    parser.add_argument("--sha", default="HEAD")
    parser.add_argument("--show", action="store_true")
    args = parser.parse_args(argv)
    cwd = os.getcwd()
    branch = run("git", "symbolic-ref", "--short", "-q", "HEAD", cwd=cwd).stdout.strip()
    if not branch:
        sys.exit("not on a branch: run this in the PR's worktree")
    path = review_log(branch, cwd)
    if args.show or not args.verdict:
        if not args.show:
            parser.error("give a verdict or --show")
        try:
            with open(path) as f:
                print(f.read().rstrip() or "no reviews recorded")
        except FileNotFoundError:
            print("no reviews recorded")
        return
    sha = run("git", "rev-parse", "--verify", f"{args.sha}^{{commit}}", cwd=cwd).stdout.strip()
    if not sha:
        sys.exit(f"unknown commit {args.sha}")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    at = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with open(path, "a") as f:
        f.write("\t".join((sha, args.verdict, at, args.by)) + "\n")
    print(f"{branch}: {args.verdict} at {sha[:10]}")


if __name__ == "__main__":
    main(sys.argv[1:])

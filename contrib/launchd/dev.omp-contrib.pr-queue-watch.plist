<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for `pr-queue watch` as a launchd agent (macOS). `/contribute setup` fills the {{…}}
  placeholders, writes it to ~/Library/LaunchAgents/dev.omp-contrib.pr-queue-watch.plist and runs
  `launchctl bootstrap gui/$(id -u) <that file>`. The watcher only reads GitHub and writes the queue
  record on your fork's queue branch: it never opens, pushes a PR branch or comments.
    {{SKILL_DIR}}         the omp-contrib skill directory (holds scripts/pr-queue)
    {{CHECKOUT}}          your oh-my-pi clone (`paths.checkout`)
    {{PATH}}              a PATH that finds git, gh and python3 >= 3.11 (launchd starts with a bare one)
    {{INTERVAL_SECONDS}}  seconds between runs, e.g. 1800
    {{LOG_DIR}}           where stdout/stderr go, e.g. ~/.cache/omp-contrib (expanded; launchd does not expand ~)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.omp-contrib.pr-queue-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/env</string>
		<string>python3</string>
		<string>{{SKILL_DIR}}/scripts/pr-queue</string>
		<string>--repo</string>
		<string>{{CHECKOUT}}</string>
		<string>watch</string>
	</array>
	<key>WorkingDirectory</key>
	<string>{{CHECKOUT}}</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{{PATH}}</string>
	</dict>
	<key>StartInterval</key>
	<integer>{{INTERVAL_SECONDS}}</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>{{LOG_DIR}}/pr-queue-watch.log</string>
	<key>StandardErrorPath</key>
	<string>{{LOG_DIR}}/pr-queue-watch.log</string>
</dict>
</plist>
